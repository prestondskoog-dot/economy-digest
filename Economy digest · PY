#!/usr/bin/env python3
"""
Economy Digest - Daily 6am CDT email with economic news & data.
Requires: pip install requests beautifulsoup4 schedule pytz
"""

import smtplib
import schedule
import time
import pytz
import requests
from datetime import datetime
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText
from bs4 import BeautifulSoup

# ─────────────────────────────────────────────
# ✏️  CONFIGURATION — fill these in before running
# ─────────────────────────────────────────────
EMAIL_SENDER   = "your_gmail@gmail.com"      # Your Gmail address
EMAIL_PASSWORD = "your_app_password_here"    # Gmail App Password (see note below)
EMAIL_RECIPIENT = "your_email@example.com"   # Where to send the digest

# ─────────────────────────────────────────────
# DATA SOURCES
# ─────────────────────────────────────────────

def fetch_fred_series(series_id: str, label: str) -> str:
    """Fetch latest value from FRED (Federal Reserve Economic Data) — no API key needed."""
    url = f"https://fred.stlouisfed.org/graph/fredgraph.csv?id={series_id}"
    try:
        r = requests.get(url, timeout=10)
        lines = r.text.strip().split("\n")
        # Last non-empty line
        for line in reversed(lines):
            if line and not line.startswith("DATE"):
                date, value = line.split(",")
                return f"<tr><td>{label}</td><td><b>{float(value):,.2f}</b></td><td>{date}</td></tr>"
    except Exception as e:
        return f"<tr><td>{label}</td><td colspan='2'>Unavailable ({e})</td></tr>"
    return f"<tr><td>{label}</td><td colspan='2'>No data</td></tr>"


def fetch_market_data() -> str:
    """Fetch stock index data from Yahoo Finance."""
    tickers = {
        "^GSPC": "S&P 500",
        "^DJI":  "Dow Jones",
        "^IXIC": "NASDAQ",
        "^TNX":  "10-Yr Treasury Yield",
        "GC=F":  "Gold ($/oz)",
        "CL=F":  "Crude Oil ($/bbl)",
        "EURUSD=X": "EUR/USD",
    }
    rows = ""
    for ticker, name in tickers.items():
        try:
            url = f"https://query1.finance.yahoo.com/v8/finance/chart/{ticker}?interval=1d&range=2d"
            headers = {"User-Agent": "Mozilla/5.0"}
            r = requests.get(url, headers=headers, timeout=10)
            data = r.json()
            closes = data["chart"]["result"][0]["indicators"]["quote"][0]["close"]
            closes = [c for c in closes if c is not None]
            if len(closes) >= 2:
                prev, curr = closes[-2], closes[-1]
                change = curr - prev
                pct    = (change / prev) * 100
                color  = "#16a34a" if change >= 0 else "#dc2626"
                arrow  = "▲" if change >= 0 else "▼"
                rows += (
                    f"<tr><td>{name}</td>"
                    f"<td><b>{curr:,.2f}</b></td>"
                    f"<td style='color:{color}'>{arrow} {abs(change):,.2f} ({abs(pct):.2f}%)</td></tr>"
                )
            else:
                rows += f"<tr><td>{name}</td><td colspan='2'>Unavailable</td></tr>"
        except Exception as e:
            rows += f"<tr><td>{name}</td><td colspan='2'>Error: {e}</td></tr>"
    return rows


def fetch_econ_news() -> str:
    """Scrape top economic headlines from Reuters."""
    try:
        url = "https://www.reuters.com/business/finance/"
        headers = {"User-Agent": "Mozilla/5.0"}
        r = requests.get(url, headers=headers, timeout=10)
        soup = BeautifulSoup(r.text, "html.parser")
        headlines = []
        for tag in soup.find_all(["h3", "h4"], limit=60):
            text = tag.get_text(strip=True)
            if len(text) > 30:
                parent = tag.find_parent("a")
                href = parent["href"] if parent and parent.get("href") else "#"
                if not href.startswith("http"):
                    href = "https://www.reuters.com" + href
                headlines.append((text, href))
            if len(headlines) >= 8:
                break
        items = "".join(f'<li><a href="{h}" style="color:#1d4ed8">{t}</a></li>' for t, h in headlines)
        return items or "<li>No headlines found</li>"
    except Exception as e:
        return f"<li>Could not fetch news: {e}</li>"


def fetch_economic_indicators() -> str:
    """Pull key FRED macro indicators."""
    indicators = [
        ("CPIAUCSL",  "CPI (Consumer Price Index)"),
        ("UNRATE",    "Unemployment Rate (%)"),
        ("GDP",       "GDP (Billions USD)"),
        ("FEDFUNDS",  "Federal Funds Rate (%)"),
        ("T10YIE",    "10-Yr Inflation Expectation (%)"),
        ("M2SL",      "M2 Money Supply (Billions USD)"),
        ("HOUST",     "Housing Starts (Thousands)"),
        ("RSAFS",     "Retail Sales (Millions USD)"),
    ]
    rows = ""
    for series_id, label in indicators:
        rows += fetch_fred_series(series_id, label)
    return rows


# ─────────────────────────────────────────────
# EMAIL BUILDER
# ─────────────────────────────────────────────

def build_email_html() -> str:
    cdt = pytz.timezone("America/Chicago")
    now = datetime.now(cdt).strftime("%A, %B %d, %Y — %I:%M %p CDT")

    market_rows    = fetch_market_data()
    indicator_rows = fetch_economic_indicators()
    news_items     = fetch_econ_news()

    table_style = """
        border-collapse: collapse; width: 100%; margin-bottom: 24px;
    """
    th_style = "background:#1e3a5f; color:white; padding:8px 12px; text-align:left;"
    td_style = "padding:7px 12px; border-bottom:1px solid #e5e7eb;"

    html = f"""
    <html><body style="font-family:Arial,sans-serif;max-width:700px;margin:auto;background:#f9fafb;padding:24px;">
      <div style="background:#1e3a5f;color:white;padding:20px 24px;border-radius:8px 8px 0 0;">
        <h1 style="margin:0;font-size:22px;">📈 Daily Economy Digest</h1>
        <p style="margin:4px 0 0;opacity:0.8;font-size:13px;">{now}</p>
      </div>
      <div style="background:white;padding:24px;border-radius:0 0 8px 8px;border:1px solid #e5e7eb;">

        <h2 style="color:#1e3a5f;">🏦 Market Snapshot</h2>
        <table style="{table_style}">
          <thead><tr>
            <th style="{th_style}">Index / Asset</th>
            <th style="{th_style}">Price</th>
            <th style="{th_style}">Change</th>
          </tr></thead>
          <tbody>
            {"".join(f'<tr>' + row.replace('<tr>','').replace('</tr>','') + '</tr>' for row in market_rows.split('</tr>') if '<td>' in row)}
          </tbody>
        </table>

        <h2 style="color:#1e3a5f;">📊 Economic Indicators (FRED)</h2>
        <table style="{table_style}">
          <thead><tr>
            <th style="{th_style}">Indicator</th>
            <th style="{th_style}">Latest Value</th>
            <th style="{th_style}">As Of</th>
          </tr></thead>
          <tbody style="font-size:14px;">
            {"".join(f'<tr style="">' + row.replace('<tr>','').replace('</tr>','').replace('<td>',f'<td style="{td_style}">') + '</tr>' for row in indicator_rows.split('</tr>') if '<td>' in row)}
          </tbody>
        </table>

        <h2 style="color:#1e3a5f;">📰 Top Economic Headlines</h2>
        <ul style="font-size:14px;line-height:2;">{news_items}</ul>

        <p style="font-size:11px;color:#9ca3af;margin-top:32px;border-top:1px solid #e5e7eb;padding-top:12px;">
          Data sourced from Yahoo Finance, Federal Reserve (FRED), and Reuters. 
          Sent automatically every day at 6:00 AM CDT.
        </p>
      </div>
    </body></html>
    """
    return html


# ─────────────────────────────────────────────
# SEND EMAIL
# ─────────────────────────────────────────────

def send_digest():
    print(f"[{datetime.now()}] Building economy digest...")
    html = build_email_html()

    msg = MIMEMultipart("alternative")
    msg["Subject"] = f"📈 Economy Digest — {datetime.now().strftime('%b %d, %Y')}"
    msg["From"]    = EMAIL_SENDER
    msg["To"]      = EMAIL_RECIPIENT
    msg.attach(MIMEText(html, "html"))

    try:
        with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
            server.login(EMAIL_SENDER, EMAIL_PASSWORD)
            server.sendmail(EMAIL_SENDER, EMAIL_RECIPIENT, msg.as_string())
        print(f"[{datetime.now()}] ✅ Digest sent to {EMAIL_RECIPIENT}")
    except Exception as e:
        print(f"[{datetime.now()}] ❌ Failed to send: {e}")


# ─────────────────────────────────────────────
# SCHEDULER — runs at 6:00 AM CDT every day
# ─────────────────────────────────────────────

def run_scheduler():
    # Schedule fires at 06:00 in local system time.
    # If your server is UTC, change "06:00" to "11:00" (UTC = CDT + 5hrs).
    schedule.every().day.at("06:00").do(send_digest)
    print("⏰ Scheduler started. Digest will send daily at 6:00 AM CDT.")
    print("   (Press Ctrl+C to stop)\n")

    # Send immediately on first run so you can verify it works
    send_digest()

    while True:
        schedule.run_pending()
        time.sleep(30)


if __name__ == "__main__":
    run_scheduler()
